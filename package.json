{
  "name": "chatgpt-chat-exporter",
  "version": "1.2.2",
  "description": "Export ChatGPT and Google Gemini conversations to Markdown, HTML, or PDF-ready files from the browser console or as userscripts.",
  "main": "src/extraction-engine.js",
  "scripts": {
    "build": "node scripts/build-exporters.js && node scripts/build-bookmarklets.js",
    "test": "node scripts/build-exporters.js --check && node scripts/build-bookmarklets.js --check && node --test",
    "release:prepare": "npm run build && npm test && node scripts/package-release.js",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rashidazarang/chatgpt-chat-exporter.git"
  },
  "keywords": [
    "chatgpt",
    "gemini",
    "export",
    "markdown",
    "pdf",
    "userscript",
    "conversation"
  ],
  "author": "Rashid Azarang <rashid.azarang.eg@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rashidazarang/chatgpt-chat-exporter/issues"
  },
  "homepage": "https://github.com/rashidazarang/chatgpt-chat-exporter#readme",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jsdom": "30.1.0",
    "terser": "5.51.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
